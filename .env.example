# TradeSensei environment configuration
# Copy to .env and adjust before running 'docker compose -f docker-compose.release.yml up'

# --- Database ---
DB_USER=tradesensei
DB_PASSWORD=change-me-in-production
DB_NAME=tradesensei
DATABASE_URL=postgresql+asyncpg://tradesensei:change-me-in-production@db:5432/tradesensei

# --- Application ---
# Generate a strong key: openssl rand -hex 32
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000
API_URL=http://localhost:8000

# --- Object Storage (Optional if using bundled SeaweedFS) ---
# STORAGE_BACKEND=s3
# STORAGE_BUCKET=tradesensei
# STORAGE_PUBLIC_URL=http://localhost:8333/tradesensei
# STORAGE_ACCESS_KEY=any
# STORAGE_SECRET_KEY=any
# STORAGE_ENDPOINT_URL=http://seaweedfs:8333
WEED_JWT_FILER_SIGNING_KEY=7a8f9c1b2d3e4f5a6b7c8d9e0f1a2b3c

# --- Optional ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=