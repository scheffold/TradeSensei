{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "./.agents/hooks/rtk-hook-gemini.sh"
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./.agents/hooks/rtk-hook-gemini.sh"
          }
        ]
      }
    ]
  }
}
