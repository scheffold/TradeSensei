# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Storage access mode for presigned URLs:
# - proxy (default): route through /api/storage-proxy
# - direct: browser calls storage endpoint directly
NEXT_PUBLIC_STORAGE_ACCESS_MODE=proxy

# Google OAuth — public client ID exposed to the browser
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# NextAuth.js
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Set to "true" to enable each module. All default to false (opt-in).
NEXT_PUBLIC_ENABLE_TAX_MODULE=false
NEXT_PUBLIC_ENABLE_DIVIDEND_MODULE=false
NEXT_PUBLIC_ENABLE_ADVANCED_EFFICIENCY=false
