# TradeSensei environment configuration
# Copy to .env and adjust before running 'docker compose -f docker-compose.release.yml up'

# --- Database ---
DB_USER=tradesensei
DB_PASSWORD=change-me-in-production
DB_NAME=tradesensei
DATABASE_URL=postgresql+asyncpg://tradesensei:change-me-in-production@db:5432/tradesensei

# --- Application ---
# Generate a strong key: openssl rand -hex 32
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000
API_URL=http://localhost:8000

# --- Optional ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
