<?xml version="1.0" encoding="UTF-8"?>
<!--
  Synthetic IBKR Flex Query XML — Year 2 fixture.

  Must be imported AFTER synthetic_year1.xml.  Closes the cross-year and
  post-split positions opened in year 1.

  S3  Cross-year close:  TSLA SELL 5 @ 120  (closes the 5 opened in year 1)
  S4  Reverse split (1:10 ratio, conid 111 → 222) then close:
        CorporateAction RS SPLK 100→10 shares, old conid=111, new conid=222
        SELL 10 SPLK @ 80  conid=222

  Transaction IDs are in the 2000-2999 range for Year 2.
  Account: U99999999
-->
<FlexQueryResponse queryName="SyntheticY2" type="AF">
  <FlexStatements count="1">
    <FlexStatement accountId="U99999999" fromDate="20250101" toDate="20251231" period="Annual">

      <!-- ================================================================
           Corporate Action: SPLK 10:1 reverse split on 2025-03-01
           conid changes 111 -> 222
           ratio = 10 / 100 = 0.1 (i.e., 100 old shares -> 10 new shares)
           ================================================================ -->
      <CorporateActions>

        <!-- old side: -100 shares (debit) -->
        <CorporateAction accountId="U99999999" assetCategory="STK" symbol="SPLK"
                         conid="111" quantity="-100" type="RS"
                         dateTime="20250301;000000" actionID="CA001" currency="USD" />

        <!-- new side: +10 shares (credit, new conid) -->
        <CorporateAction accountId="U99999999" assetCategory="STK" symbol="SPLK"
                         conid="222" quantity="10" type="RS"
                         dateTime="20250301;000000" actionID="CA001" currency="USD" />

      </CorporateActions>

      <Trades>

        <!-- ================================================================
             S3: TSLA cross-year close
             ================================================================ -->

        <!-- S3 close: SELL 5 TSLA @ 120.00  2025-02-01 -->
        <Trade accountId="U99999999" assetCategory="STK" symbol="TSLA" conid="76792991"
               tradeDate="20250201" dateTime="20250201;143000"
               quantity="-5" tradePrice="120.00" ibCommission="-1.00"
               fifoPnlRealized="98.00" openCloseIndicator="C"
               buySell="SELL" transactionID="2001" multiplier="1" currency="USD" />

        <!-- ================================================================
             S4: SPLK post-split close
             After the 10:1 reverse split:
               original 100 shares @ 10.00  →  10 shares @ 100.00
             Now sell 10 @ 80.00 (loss: (80-100)*10 = -200)
             ================================================================ -->

        <!-- S4 close: SELL 10 SPLK @ 80.00  2025-04-01  conid=222 (new post-split) -->
        <Trade accountId="U99999999" assetCategory="STK" symbol="SPLK" conid="222"
               tradeDate="20250401" dateTime="20250401;100000"
               quantity="-10" tradePrice="80.00" ibCommission="-0.50"
               fifoPnlRealized="-201.00" openCloseIndicator="C"
               buySell="SELL" transactionID="2010" multiplier="1" currency="USD" />

      </Trades>

    </FlexStatement>
  </FlexStatements>
</FlexQueryResponse>
