        <!-- S6 close: SELL 3 GOOG @ 100.00  2024-07-05  breakeven (pnl=0 but IS closing) -->
        <Trade accountId="U99999999" assetCategory="STK" symbol="GOOG" conid="208813719"
               tradeDate="20240705" dateTime="20240705;150000"
               quantity="-3" tradePrice="100.00" ibCommission="-0.10"
               fifoPnlRealized="0" openCloseIndicator="C"
               buySell="SELL" transactionID="1051" multiplier="1" currency="USD" />

        <!-- ================================================================
             S7: AMZN multi-lot close (same timestamp for both closes)
             ================================================================ -->

        <!-- S7 open lot A: BUY 10 AMZN @ 200.00  2024-08-01 txid=7001 -->
        <Trade accountId="U99999999" assetCategory="STK" symbol="AMZN" conid="3691937"
               tradeDate="20240801" dateTime="20240801;093000"
               quantity="10" tradePrice="200.00" ibCommission="-0.50"
               fifoPnlRealized="0" openCloseIndicator="O"
               buySell="BUY" transactionID="1060" multiplier="1" currency="USD" />

