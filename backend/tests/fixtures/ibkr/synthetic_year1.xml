        <!-- S7 close2: SELL 5 AMZN @ 210.00  2024-08-15 txid=7004  closes lot B, same timestamp as 7003 -->
        <Trade accountId="U99999999" assetCategory="STK" symbol="AMZN" conid="3691937"
               tradeDate="20240815" dateTime="20240815;100000"
               quantity="-5" tradePrice="210.00" ibCommission="-0.25"
               fifoPnlRealized="39.75" openCloseIndicator="C"
               buySell="SELL" transactionID="1063" multiplier="1" currency="USD" />

      </Trades>

    </FlexStatement>
  </FlexStatements>
</FlexQueryResponse>
