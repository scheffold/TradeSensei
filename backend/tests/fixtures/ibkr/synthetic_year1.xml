        <Trade accountId="U99999999" assetCategory="STK" symbol="NFLX" conid="15124"
               tradeDate="20240615" dateTime="20240615;143000"
               quantity="5" tradePrice="530.00" ibCommission="-0.25"
               fifoPnlRealized="-50.00" openCloseIndicator="C"
               buySell="BUY" transactionID="1042" multiplier="1" currency="USD" />

        <!-- ================================================================
             S6: GOOG zero-PnL closing execution (breakeven, pnlRealized=0)
