               buySell="BUY" transactionID="1061" multiplier="1" currency="USD" />

        <!-- S7 close1: SELL 10 AMZN @ 210.00  2024-08-15 txid=7003  closes lot A FIFO -->
        <Trade accountId="U99999999" assetCategory="STK" symbol="AMZN" conid="3691937"
